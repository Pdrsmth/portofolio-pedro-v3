---
const title = "Pedro Masdy | Data and AI Analyst";
const description = "Pedro Masdy is a Data and AI Analyst. Thesis-grade churn prediction (AUC 0.9377), SQL and Python analysis, and production web systems.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <style>
    :root {
      --navy: #0a192f;
      --navy-light: #112240;
      --navy-lighter: #233554;
      --text: #ccd6f6;
      --muted: #8892b0;
      --mint: #64ffda;
      --white: #e6f1ff;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 120px; }
    body {
      margin: 0;
      background: var(--navy);
      color: var(--text);
      font-family: "Inter", system-ui, -apple-system, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--mint); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }

    /* Fixed top nav, v4 style */
    header.nav {
      position: fixed; inset: 0 0 auto 0; z-index: 20;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 50px; height: 100px; background: rgba(10, 25, 47, 0.98);
      backdrop-filter: blur(10px);
    }
    header.nav .logo { display: flex; align-items: center; color: var(--mint); }
    header.nav .logo svg { width: 46px; height: 46px; }
    header.nav .logo:hover { text-decoration: none; }
    header.nav nav { display: flex; gap: 36px; align-items: center; }
    header.nav nav a { color: var(--text); font-size: 16px; }
    header.nav nav a span { color: var(--mint); margin-right: 5px; }
    header.nav nav a:hover { color: var(--mint); text-decoration: none; }
    .btn {
      display: inline-block; padding: 16px 24px; font-family: "JetBrains Mono", ui-monospace, monospace;
      border: 1px solid var(--mint); border-radius: 4px;
      color: var(--mint); font-size: 15px;
    }
    .btn:hover { background: rgba(100, 255, 218, 0.1); text-decoration: none; }
    .lang-toggle { display: flex; gap: 6px; align-items: center; }
    .lang-toggle button { background: none; border: none; cursor: pointer; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 15px; color: var(--muted); padding: 4px 2px; }
    .lang-toggle button:hover { color: var(--mint); }
    .lang-toggle button.active { color: var(--mint); }
    .lang-toggle .sep { color: var(--muted); }
    .mobile-menu .lang-toggle { padding: 12px 0 4px; }
    .mobile-menu { display: none; }
    .mobile-menu summary { list-style: none; cursor: pointer; color: var(--mint); font-size: 15px; }
    .mobile-menu nav { display: flex; flex-direction: column; gap: 12px; padding: 16px 0 4px; }
    .mobile-menu nav a { color: var(--text); font-size: 14px; }

    /* Fixed sidebars, v4 style, with the user-requested thicker line */
    .side { position: fixed; bottom: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 20px; }
    .side.left { left: 40px; }
    .side.right { right: 40px; }
    .side.right a { writing-mode: vertical-rl; font-size: 14px; letter-spacing: 0.1em; color: var(--muted); }
    .side.right a:hover { color: var(--mint); text-decoration: none; }
    .side .line { width: 2px; height: 160px; background: var(--text); }
    .side.left a { color: var(--muted); display: flex; }
    .side.left a svg { width: 24px; height: 24px; fill: currentColor; }
    .side.left a.instagram svg { fill: none; stroke: currentColor; stroke-width: 1.5; }
    .side.left a:hover { color: var(--mint); transform: translateY(-3px); }
    .side.left a { transition: transform 0.2s ease, color 0.2s ease; }

    main { max-width: 1600px; margin: 0 auto; padding: 0 150px 80px; }
    #about .about-grid, #about .section-head { max-width: 900px; margin-left: auto; margin-right: auto; }
    #experience .jobs, #experience .section-head { max-width: 1000px; margin-left: auto; margin-right: auto; }
    #projects .featured, #projects .grid, #projects .section-head { max-width: 1000px; margin-left: auto; margin-right: auto; }
    #projects h3:not(.card h3):not(.feat-text h3) { max-width: 1000px; margin-left: auto; margin-right: auto; }
    #journey .orgs, #journey .section-head, #certifications .grid, #certifications .section-head { max-width: 1000px; margin-left: auto; margin-right: auto; }
    section { padding: 140px 0 40px; scroll-margin-top: 120px; }
    .section-head { display: flex; align-items: center; gap: 16px; margin-bottom: 40px; }
    .section-head .num { color: var(--mint); font-size: 20px; font-weight: 400; }
    .section-head h2 { margin: 0; color: var(--white); font-size: 36px; font-weight: 700; line-height: 1.1; white-space: nowrap; }
    .section-head .rule { flex: 1; height: 1px; background: var(--navy-lighter); max-width: 300px; }

    /* Hero, full height, v4 style */
    .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 100px 0 0; }
    .hero .intro { color: var(--mint); font-size: 18px; margin: 0 0 20px; }
    .hero h1 { margin: 0; color: var(--white); font-size: clamp(48px, 8vw, 88px); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
    .hero h2 { margin: 0 0 28px; color: var(--muted); font-size: clamp(48px, 8vw, 88px); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
    .hero p { max-width: 540px; color: var(--muted); font-size: 20px; margin: 0; }
    .hero .cta { margin-top: 50px; }
    .hero .cta .btn { padding: 20px 32px; font-size: 16px; }

    /* About: text left, photo right with offset mint frame */
    .about-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 50px; align-items: start; }
    .about-grid p { color: var(--muted); font-size: 18px; }
    .about-grid p strong { color: var(--text); font-weight: 500; }
    .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; padding: 0; margin: 24px 0 0; list-style: none; }
    .skills li { color: var(--text); font-size: 15px; }
    .skills li::before { content: "▹ "; color: var(--mint); }
    .photo-wrap { position: relative; max-width: 300px; margin-left: auto; background: var(--mint); border-radius: 4px; }
    .photo-wrap:hover { background: transparent; }
    .photo-wrap::after {
      content: ""; position: absolute; inset: 0; z-index: 0;
      border: 2px solid var(--mint); border-radius: 4px;
      transform: translate(20px, 20px); transition: transform 0.25s ease;
    }
    .photo-wrap:hover::after { transform: translate(15px, 15px); }
    .photo-wrap:hover img { filter: none; mix-blend-mode: normal; }
    .photo-wrap img { position: relative; z-index: 1; display: block; width: 100%; border-radius: 4px; mix-blend-mode: multiply; filter: grayscale(100%) contrast(1); transition: filter 0.25s ease, mix-blend-mode 0.25s ease; }

    /* Experience: v4-style tabs */
    .jobs { display: grid; grid-template-columns: 220px 1fr; gap: 40px; align-items: start; }
    .job-tabs { display: flex; flex-direction: column; border-left: 2px solid var(--navy-lighter); }
    .job-tabs button {
      background: none; border: none; border-left: 2px solid transparent; margin-left: -2px;
      padding: 12px 20px; text-align: left; cursor: pointer;
      color: var(--muted); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 15px;
    }
    .job-tabs button:hover { color: var(--mint); background: var(--navy-light); }
    .job-tabs button.active { color: var(--mint); border-left-color: var(--mint); background: var(--navy-light); }
    .job-panel { display: none; }
    .job-panel.active { display: block; }
    .job-panel h3 { margin: 0 0 4px; color: var(--white); font-size: 26px; font-weight: 600; }
    .job-panel h3 span { color: var(--mint); }
    .job-panel .meta { color: var(--muted); font-size: 15px; margin: 0 0 20px; }
    .job-panel p { color: var(--muted); margin: 0; font-size: 18px; }
    .job-panel ul { color: var(--muted); margin: 0; padding-left: 0; list-style: none; font-size: 18px; }
    .job-panel li { position: relative; margin-bottom: 12px; padding-left: 30px; }
    .job-panel li::before { content: "\25b9"; position: absolute; left: 0; color: var(--mint); }

    /* Featured projects: alternating text / visual panel */
    .featured { display: grid; grid-template-columns: repeat(12, 1fr); margin-bottom: 100px; align-items: center; }
    .featured .feat-text { grid-column: 1 / 8; grid-row: 1; z-index: 2; padding: 0; }
    .featured .feat-panel { grid-column: 7 / 13; grid-row: 1; }
    .featured.reverse .feat-text { grid-column: 6 / 13; text-align: right; }
    .featured.reverse .feat-panel { grid-column: 1 / 7; }
    .featured.reverse .feat-tech { justify-content: flex-end; }
    .feat-label { color: var(--mint); font-size: 15px; margin: 0 0 10px; }
    .feat-text h3 a { color: var(--white); }
    .feat-text h3 a:hover { color: var(--mint); text-decoration: none; }
    .feat-text h3 { margin: 0 0 16px; color: var(--white); font-size: 32px; font-weight: 700; line-height: 1.2; }
    .feat-text p { color: var(--muted); margin: 0 0 20px; font-size: 18px; }
    .feat-tech { display: flex; flex-wrap: wrap; gap: 18px; padding: 0; margin: 0; list-style: none; color: var(--muted); font-size: 15px; }
    .feat-panel {
      min-height: 360px; display: flex; flex-direction: column; justify-content: center; gap: 12px;
      padding: 40px; background: var(--navy-light); border: 1px solid var(--navy-lighter); border-radius: 4px;
      box-shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
    }
    .feat-panel .metric { color: var(--mint); font-size: 40px; font-weight: 700; line-height: 1.2; }
    .feat-panel p { color: var(--text); margin: 0; font-size: 20px; }

    /* Other projects: folder-icon cards, v4 style */
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .grid .card {
      display: flex; flex-direction: column; min-height: 300px;
      border: none; border-radius: 4px; background: var(--navy-light); padding: 32px 28px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .grid .card:hover { transform: translateY(-7px); box-shadow: 0 20px 30px -15px rgba(2, 12, 27, 0.7); }
    .grid .card .card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
    .grid .card .card-top .folder { margin-bottom: 0; }
    .grid .card .card-links { display: flex; gap: 12px; color: var(--muted); }
    .grid .card .card-links a { color: var(--muted); }
    .grid .card .card-links a:hover { color: var(--mint); }
    .grid .card .card-links svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; }
    .grid .card .folder { color: var(--mint); margin-bottom: 20px; }
    .grid .card .folder svg { width: 48px; height: 48px; fill: none; stroke: currentColor; stroke-width: 1.5; }
    .grid .card h3 a { color: var(--white); }
    .grid .card h3 a:hover { color: var(--mint); text-decoration: none; }
    .grid .card h3 { margin: 0 0 12px; color: var(--white); font-size: 24px; font-weight: 600; line-height: 1.25; }
    .grid .card p { color: var(--muted); font-size: 18px; margin: 0 0 auto; }
    .grid .card .tech { color: var(--muted); font-size: 14px; margin-top: 24px; }

    /* Journey, certifications */
    .orgs, .certs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .plain-card { background: var(--navy-light); border-radius: 4px; padding: 28px; }
    .plain-card h3 { margin: 0 0 10px; color: var(--white); font-size: 24px; font-weight: 600; line-height: 1.25; }
    .plain-card p { color: var(--muted); margin: 0 0 16px; font-size: 18px; }

    /* Contact, v4 centered style */
    .contact { text-align: center; max-width: 600px; margin: 0 auto; }
    .contact .label { color: var(--mint); font-size: 18px; margin: 0 0 20px; }
    .contact h2 { color: var(--white); font-size: clamp(48px, 6vw, 68px); font-weight: 800; line-height: 1.1; margin: 0 0 18px; }
    .contact p { color: var(--muted); font-size: 18px; }
    .contact .cta { margin-top: 50px; }
    .contact .cta .btn { padding: 20px 32px; font-size: 16px; }
    .contact-links { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 36px; font-size: 16px; }
    footer { text-align: center; color: var(--muted); font-size: 12px; padding: 60px 24px 20px; }

    .fade { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .fade.visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .fade { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
    }

    @media (max-width: 900px) {
      .grid, .orgs, .certs { grid-template-columns: 1fr 1fr; }
      .about-grid, .featured { grid-template-columns: 1fr; }
      .featured .feat-text, .featured.reverse .feat-text { grid-column: auto; grid-row: auto; text-align: left; padding: 0 0 24px; }
      .featured .feat-panel, .featured.reverse .feat-panel { grid-column: auto; grid-row: auto; }
      .featured.reverse .feat-tech { justify-content: flex-start; }
      .photo-wrap { margin-left: 0; }
      .jobs { grid-template-columns: 1fr; }
      .job-tabs { flex-direction: row; border-left: none; border-bottom: 2px solid var(--navy-lighter); overflow-x: auto; }
      .job-tabs button { border-left: none; border-bottom: 2px solid transparent; margin: 0 0 -2px; white-space: nowrap; }
      .job-tabs button.active { border-bottom-color: var(--mint); }
    }
    @media (max-width: 1080px) {
      main { padding: 0 100px 80px; }
    }
    @media (max-width: 768px) {
      .side { display: none; }
      header.nav { padding: 0 20px; height: 80px; }
      header.nav .desktop-nav { display: none; }
      .mobile-menu { display: block; }
      section { padding: 110px 0 20px; scroll-margin-top: 100px; }
      .grid, .orgs, .certs { grid-template-columns: 1fr; }
      main { padding: 0 20px 60px; }
      .section-head h2 { white-space: normal; }
    }
  </style>
</head>
